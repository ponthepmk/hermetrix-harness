{
  "openapi": "3.1.0",
  "info": {"title": "Hermetrix Platform additions", "version": "development-schema-83", "description": "Contracts for the new automation intake endpoints. The complete existing route inventory is in route-inventory.json; it is not a complete schema specification. All requests retain the application's Host/Origin/authentication boundary. Schedules create local-only draft tasks requiring review, never autonomous tool execution."},
  "paths": {
    "/api/automations": {
      "get": {"operationId": "listAutomations", "responses": {"200": {"description": "Only the current principal's schedules", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Schedule"}}}}}}},
      "post": {"operationId": "saveAutomation", "description": "Creation requires a stable request_id; replay with the same owner/key/template returns the original schedule. Changes require id plus exact revision. Enabled schedules create reviewable tasks only. Pausing does not cancel previously created tasks.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Input"}}}}, "responses": {"201": {"description": "Created or recovered idempotent creation", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Schedule"}}}}, "200": {"description": "Updated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Schedule"}}}}, "400": {"description": "Invalid input"}, "409": {"description": "Stale revision or changed idempotent creation"}}}
    },
    "/api/automations/{id}/trigger": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
      "post": {"operationId": "triggerAutomation", "description": "An authenticated event or manual trigger. Repeat request_id returns the same receipt. Pending tasks cause skipped_overlap instead of another draft.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["request_id"], "properties": {"request_id": {"type": "string", "minLength": 1, "maxLength": 128}}}}}}, "responses": {"200": {"description": "Committed or replayed receipt", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Run"}}}}, "404": {"description": "Schedule unavailable to this principal"}, "409": {"description": "Disabled or changed schedule"}}}
    },
    "/api/automations/{id}/runs": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
      "get": {"operationId": "listAutomationRuns", "responses": {"200": {"description": "Latest 100 receipts for an owned schedule", "content": {"application/json": {"schema": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/Run"}}}}}, "404": {"description": "Not available to this principal"}}}
    }
  },
  "components": {"schemas": {
    "Input": {"type": "object", "additionalProperties": false, "required": ["name", "template", "interval_seconds", "enabled"], "properties": {
      "id": {"type": "string"}, "request_id": {"type": "string", "minLength": 1, "maxLength": 128}, "revision": {"type": "integer", "minimum": 1}, "name": {"type": "string", "minLength": 1, "description": "Maximum 120 UTF-8 bytes"}, "template": {"$ref": "#/components/schemas/Template"}, "interval_seconds": {"oneOf": [{"const": 0}, {"type": "integer", "minimum": 300, "maximum": 2592000}]}, "timezone": {"type": "string", "default": "Asia/Bangkok", "description": "Valid IANA timezone; intervals are elapsed durations, not wall-clock cron expressions"}, "enabled": {"type": "boolean"}
    }, "allOf": [{"if": {"required": ["id"]}, "then": {"required": ["revision"]}, "else": {"required": ["request_id"]}}]},
    "Template": {"type": "object", "required": ["project_id", "title", "objective", "original_request", "criteria"], "description": "TaskEngine CreateTaskInput, <=16384 encoded bytes. Actor is bound to the authenticated principal and egress forced local_only. A draft may carry a goal contract but never receives execution approval from this endpoint.", "properties": {"project_id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "objective": {"type": "string", "minLength": 1}, "original_request": {"type": "string", "minLength": 1}, "criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "description"], "properties": {"id": {"type": "string"}, "description": {"type": "string"}}}}, "constraints": {"type": "array", "items": {"type": "string"}}, "unknowns": {"type": "array", "items": {"type": "string"}}, "contract": {"type": "object"}, "actor": {"type": "string", "description": "Ignored and rebound"}, "egress_policy": {"type": "string", "description": "Forced local_only"}, "remote_egress_approval": {"type": ["object", "null"], "description": "Discarded"}}},
    "Schedule": {"type": "object", "required": ["id", "revision", "name", "template", "enabled", "next_run_at", "interval_seconds", "timezone"], "properties": {"id": {"type": "string"}, "revision": {"type": "integer"}, "name": {"type": "string"}, "template": {"$ref": "#/components/schemas/Template"}, "enabled": {"type": "boolean"}, "next_run_at": {"type": "string", "format": "date-time"}, "interval_seconds": {"type": "integer"}, "timezone": {"type": "string"}}},
    "Run": {"type": "object", "required": ["id", "automation_id", "task_id", "state", "created_at"], "properties": {"id": {"type": "string"}, "automation_id": {"type": "string"}, "task_id": {"type": "string", "description": "Empty when overlap was skipped"}, "state": {"enum": ["awaiting_review", "skipped_overlap"]}, "created_at": {"type": "string", "format": "date-time"}}}
  }}
}
