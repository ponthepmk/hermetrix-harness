# Any local data directory, not just the default one. A second profile started
# with --data .hermetrix-native sat outside `.hermetrix/` and was therefore one
# `git add -A` away from committing a SQLite database -- and the secrets vault
# lives at <data>/secrets.json.
.hermetrix*/
tmp-*-data/

# Local provider/embedding credentials and the launch wrapper that reads them.
# Hermetrix only ever takes the *name* of an env var; the value stays here and
# out of Git.
.env.local
/scripts/serve.local.ps1
# Root-anchored: without the leading slash this also matched the cmd/hermetrix
# directory, and the whole main package went unversioned. The repository built
# green and contained no program.
/hermetrix
coverage.out
node_modules/
.DS_Store

# The task corpus is generated, not authored. Unlike corpus/digests, whose cases
# were labelled by hand and whose provenance is the point, every task here is
# produced deterministically from a seed:
#
#   hermetrix taskeval generate --dir corpus/tasks --per-class 30 --seed 1
#
# 24 MB of repeated filler in Git would be a copy of a function, not evidence.
# The generator and its measured placement rate are the corpus; see
# corpus/tasks/README.md.
/corpus/tasks/*.json
tmp-mockup-data/

# Subagent-driven development scratch: ledgers, briefs and review packages.
# The git history is the record; these are the notes taken while making it.
.superpowers/

# Local build/test caches, browser profiles, and per-machine Git settings.
/.tmp-go-cache/
/.tmp-ui/
/internal/web/.tmp-ui/
/.hermetrix-gitconfig
/.hermetrix-pi-release.gitconfig
/scripts/video-research/.research-jobs/
/scripts/video-research/__pycache__/

# Local goal pilot state, machine-specific test configuration and MT5 evidence.
/.hermetrix-goal-pilot/
.mt5-runs/
mt5.local.json
goal.local.json

# Experiment captures include generated projects and machine-local model data.
# Keep them locally; version the harness, its standing tests and compact
# validation summaries instead. Previously tracked historical evidence stays
# tracked; this rule prevents new captures from entering future commits.
/docs/evidence/*
!/docs/evidence/README.md
