{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["idempotency_key", "message_type", "contract_version", "schema_revision", "sender_node_id", "payload", "payload_digest", "signature"],
  "properties": {
    "idempotency_key": {"type": "string", "minLength": 1},
    "message_type": {"type": "string", "minLength": 1},
    "contract_version": {"const": "agent-platform/v1"},
    "schema_revision": {"type": "integer", "minimum": 1},
    "sender_node_id": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "payload_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "signature": {
      "type": "object",
      "required": ["alg", "key_id", "value"],
      "properties": {"alg": {"type": "string"}, "key_id": {"type": "string"}, "value": {"type": "string"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
