{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["contract_version", "schema_revision", "assignment_id", "assignment_revision", "platform_run_id", "agent_id", "node_id", "repository_id", "task_id", "title", "original_request", "acceptance_criteria", "goal", "access_scope", "authorization_claim", "issued_at"],
  "properties": {
    "contract_version": {"const": "agent-platform/v1"},
    "schema_revision": {"const": 2},
    "assignment_id": {"type": "string", "minLength": 1},
    "assignment_revision": {"type": "integer", "minimum": 1},
    "platform_session_id": {"type": ["string", "null"]},
    "platform_run_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "repository_id": {"type": "string", "minLength": 1},
    "worktree_id": {"type": ["string", "null"]},
    "workspace_id": {"type": ["string", "null"]},
    "project_id": {"type": ["string", "null"]},
    "service_id": {"type": ["string", "null"]},
    "task_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "original_request": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "object", "required": ["id", "description"], "properties": {"id": {"type": "string", "pattern": "^AC-[A-Za-z0-9]+$"}, "description": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "goal": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "complexity": {"enum": ["trivial", "standard", "complex"]},
    "risk": {"enum": ["low", "medium", "high"]},
    "knowledge_context_ref": {"type": ["string", "null"]},
    "access_scope": {"$ref": "#/$defs/access"},
    "authority_scope_id": {"type": ["string", "null"]},
    "authority_generation": {"type": ["integer", "null"], "minimum": 1},
    "authorization_claim": {"$ref": "#/$defs/claim"},
    "issued_at": {"type": "string"}
  },
  "$defs": {
    "access": {"type": "object", "required": ["access", "repository_id"], "properties": {"access": {"enum": ["none", "read", "write"]}, "capabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["work.update", "work.report_result", "knowledge.submit"]}}, "repository_id": {"type": "string", "minLength": 1}, "worktree_id": {"type": ["string", "null"]}, "path_prefixes": {"type": "array", "items": {"type": "string"}}, "granted_by": {"type": "string"}, "granted_at": {"type": "string"}, "expires_at": {"type": ["string", "null"]}}, "additionalProperties": false},
    "claim": {"type": "object", "required": ["assignment_id", "assignment_revision", "node_id", "agent_id", "platform_run_id", "repository_id", "access_scope", "issued_at", "expires_at", "integrity"], "properties": {"assignment_id": {"type": "string"}, "assignment_revision": {"type": "integer", "minimum": 1}, "node_id": {"type": "string"}, "agent_id": {"type": "string"}, "platform_run_id": {"type": "string"}, "repository_id": {"type": "string"}, "worktree_id": {"type": ["string", "null"]}, "access_scope": {"$ref": "#/$defs/access"}, "authority_scope_id": {"type": ["string", "null"]}, "authority_generation": {"type": ["integer", "null"], "minimum": 1}, "issued_at": {"type": "string"}, "expires_at": {"type": "string"}, "integrity": {"type": "object", "required": ["alg", "value"], "properties": {"alg": {"type": "string"}, "value": {"type": "string"}}, "additionalProperties": false}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
