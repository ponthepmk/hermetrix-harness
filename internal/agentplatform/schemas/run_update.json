{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["platform_run_id", "sequence", "execution_status", "progress", "projection_ref", "created_at"],
  "properties": {
    "platform_run_id": {"type": "string", "minLength": 1},
    "harness_run_ref": {"type": ["string", "null"]},
    "sequence": {"type": "integer", "minimum": 1},
    "authority_scope_id": {"type": ["string", "null"]},
    "authority_generation": {"type": ["integer", "null"], "minimum": 1},
    "execution_status": {"enum": ["accepted", "initializing", "working", "blocked", "completed", "failed", "cancelled"]},
    "progress": {"type": "object", "required": ["phase", "completed_steps", "total_steps", "attempt_count", "failed_checks", "blocked_reasons"], "properties": {"phase": {"enum": ["initializing", "planning", "executing", "verifying", "finalizing", "blocked", "done"]}, "completed_steps": {"type": "integer", "minimum": 0}, "total_steps": {"type": "integer", "minimum": 0}, "current_step_id": {"type": ["string", "null"]}, "attempt_count": {"type": "integer", "minimum": 0}, "failed_checks": {"type": "integer", "minimum": 0}, "blocked_reasons": {"type": "array", "items": {"type": "string"}}, "plan_revision": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "projection_ref": {"$ref": "#/$defs/evidence"},
    "created_at": {"type": "string"}
  },
  "$defs": {"evidence": {"type": "object", "required": ["evidence_id", "type", "origin_node_id", "content_digest", "created_at"], "properties": {"evidence_id": {"type": "string"}, "type": {"enum": ["log", "diff", "test_output", "screenshot", "artifact", "cas_object", "job", "validation", "event"]}, "origin_node_id": {"type": "string"}, "run_id": {"type": ["string", "null"]}, "content_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "created_at": {"type": "string"}, "locator": {"type": ["string", "null"]}, "provenance": {"type": "object"}, "retrieval": {"type": ["object", "null"], "required": ["method"], "properties": {"method": {"enum": ["mcp", "http", "cas"]}, "endpoint_ref": {"type": "string"}}, "additionalProperties": false}}, "additionalProperties": false}},
  "additionalProperties": false
}
